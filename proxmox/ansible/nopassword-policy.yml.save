- name: Sécurisation connexion SSH
  host: all:!gummi-ship
  task:
    name: Envoie clé SSH
    - ansible.prosix.authorized_key:
        user: "{{ ansible_user }}"
        key: "{{ lookup('file', '~/.ssh/id_ed25519.pub') }}"

    name: Copie fichier conf
    - ansible.builtin.copy:
        dest: /etc/.ssh/sshd_config.d/00-no-password.conf
        content: |
          PasswordAuthentification no
        owner: root
        group: root
        chmod: '0644'
      become: true
      notify: reload ssh


